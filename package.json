{
  "name": "poetry-garden-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema": "wrangler d1 execute poetry-garden-v2 --local --file=migrations/0001_content_platform.sql",
    "db:schema:remote": "wrangler d1 execute poetry-garden-v2 --remote --file=migrations/0001_content_platform.sql",
    "db:migrations:local": "wrangler d1 migrations apply poetry-garden-v2 --local",
    "db:migrations:remote": "wrangler d1 migrations apply poetry-garden-v2 --remote",
    "db:drop-legacy-content:remote": "wrangler d1 execute poetry-garden --remote --file=maintenance/drop-legacy-content.sql",
    "db:drop-content-search:remote": "wrangler d1 execute poetry-garden --remote --file=maintenance/drop-content-search.sql",
    "db:apply-import:remote": "node scripts/apply-content-import.mjs --database poetry-garden-v2 --dir imports/content",
    "db:rebuild:v2": "bash scripts/rebuild-v2.sh",
    "import:generate": "node scripts/generate-content-import.mjs",
    "import:sample": "node scripts/generate-content-import.mjs --limit 200",
    "import:generate:full": "node scripts/generate-content-import.mjs --data ../chinese-poetry --out imports/content/v3 --r2Bucket poetry-garden-content",
    "import:sample:full": "node scripts/generate-content-import.mjs --data ../chinese-poetry --out imports/content/v3-sample --limit 5000",
    "r2:upload": "node scripts/upload-r2-direct.mjs --bucket poetry-garden-content --dir imports/content --concurrency 8 --retries 8",
    "r2:upload:v3": "node scripts/upload-r2-direct.mjs --bucket poetry-garden-content --dir imports/content/v3 --concurrency 16 --retries 8",
    "r2:upload:wrangler": "bash imports/content/upload-r2.sh poetry-garden-content"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.2.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "hono": "^4.0.0",
    "opencc-js": "^1.4.0",
    "wrangler": "^4.47.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3"
  }
}
